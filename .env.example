# Kakeez — environment variable template.
# Copy this file to .env.local and fill in real values for local development.
# .env.local is .gitignored; never commit real credentials.

# ─────────────────────────────────────────────────────────────────────────────
# Canonical public origin. Set this on Vercel Production only - preview deploys
# and local dev fall back to their own origin (see src/lib/site-url.ts). It is
# what Supabase auth emails, canonical tags, sitemap.xml and robots.txt are all
# built from, so a wrong value here mails customers a link to the wrong host.
# Whatever this is set to must also appear in supabase/config.toml under
# [auth] additional_redirect_urls.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.kakeez.com

# Google Search Console verification token. In Search Console choose the URL-prefix
# property for https://www.kakeez.com, pick the "HTML tag" method, and copy only the
# content value (not the whole meta tag). Leaving this unset emits no tag at all.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (public — safe to ship to the browser)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# Supabase service role (SECRET — server-only).
# Used by src/lib/supabase/admin.ts for privileged ops (admin RPCs, seed,
# Edge Function fallbacks). NEVER import the admin client from a
# "use client" file. Never expose this key in any NEXT_PUBLIC_* variable.
# Rotate via Supabase Dashboard → Project Settings → API if it leaks.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-server-only

# ─────────────────────────────────────────────────────────────────────────────
# Transactional notifications. Full setup walkthrough: docs/EMAIL_SETUP.md
# ─────────────────────────────────────────────────────────────────────────────
# Dry run is the DEFAULT and only the literal string "false" turns sending on.
# That asymmetry is deliberate: an unset variable means a laptop or a fresh
# preview deploy, and neither should be able to mail real customers. Keep it
# true locally; set it to false on Vercel Production only.
NOTIFICATIONS_DRY_RUN=true

# Bearer secret for /api/notifications/process (the queue drain) and
# /api/notifications/test (the credential check). Both fail CLOSED: with no
# secret set, every request is rejected rather than every request allowed.
NOTIFICATIONS_PROCESS_SECRET=change-me-long-random-secret

# Vercel Cron injects this automatically on scheduled invocations. The drain
# accepts either this or the secret above. Set it on Vercel Production so the
# every-2-minutes cron in vercel.json can actually drain the queue.
CRON_SECRET=change-me-long-random-secret

# ─────────────────────────────────────────────────────────────────────────────
# Google SMTP. GOOGLE_SMTP_PASS is an APP PASSWORD, not the account password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Google displays it as four space-separated groups; the spaces are cosmetic and
# are stripped in src/lib/notifications/smtp.ts, so either form works.
#
# Port 465 is implicit TLS (SECURE=true); 587 is STARTTLS (SECURE=false). If
# SECURE is unset it is inferred from the port.
#
# Caveat worth knowing before you debug a spam folder: Google rewrites the From
# header to GOOGLE_SMTP_USER unless GOOGLE_SMTP_FROM is a verified alias on that
# account (Gmail -> Settings -> Accounts -> "Send mail as"). kakeez.com publishes
# SPF -all and DMARC p=quarantine, so an unaligned From lands in spam.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=465
GOOGLE_SMTP_SECURE=true
GOOGLE_SMTP_USER=your-google-workspace-smtp-user
GOOGLE_SMTP_PASS=your-google-app-password
GOOGLE_SMTP_FROM=orders@kakeez.com
KAKEEZ_ADMIN_EMAIL=orders@kakeez.com

# The same GOOGLE_SMTP_USER / GOOGLE_SMTP_PASS also back Supabase Auth's own
# mail (signup confirmation, password reset, magic link) once
# `supabase config push` applies [auth.email.smtp] from supabase/config.toml.
# Export them into your shell before pushing — config.toml reads them via
# env(GOOGLE_SMTP_USER) / env(GOOGLE_SMTP_PASS).

# WhatsApp Cloud API admin alerts.
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
KAKEEZ_ADMIN_WHATSAPP_E164=923001234567
